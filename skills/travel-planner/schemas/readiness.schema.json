{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "readiness.schema.json",
  "title": "Travel Planner readiness v1",
  "type": "object",
  "required": ["schema_version", "trip_id", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "trip_id": {"$ref": "#/$defs/id"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "category", "status"],
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "category": {"enum": ["entry", "transit", "health", "medication", "insurance", "transport", "lodging", "activities", "dining", "connectivity", "money", "documents", "packing", "emergency", "pre_departure"]},
          "status": {"enum": ["unknown", "not_released_yet", "action_needed", "selected", "booked", "confirmed", "recheck", "waived", "not_applicable"]},
          "owner_id": {"type": ["string", "null"]},
          "due_at": {"type": ["string", "null"], "format": "date-time"},
          "next_check_at": {"type": ["string", "null"], "format": "date-time"},
          "source_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "claim_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}},
          "dependencies": {"type": "array", "items": {"$ref": "#/$defs/id"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"}
  }
}

