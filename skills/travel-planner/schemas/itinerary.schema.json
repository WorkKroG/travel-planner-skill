{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "itinerary.schema.json",
  "title": "Travel Planner itinerary v1",
  "type": "object",
  "required": ["schema_version", "trip_id", "document_status", "verification_level", "finalization_basis", "accepted_blockers", "route_state", "alternatives", "selected_route_id", "days", "budget_items", "challenge_findings"],
  "properties": {
    "schema_version": {"const": 1},
    "trip_id": {"$ref": "#/$defs/id"},
    "document_status": {"enum": ["draft", "final"]},
    "verification_level": {"enum": ["none", "ai_reviewed", "codex_validated"]},
    "finalization_basis": {"enum": [null, "codex_validated", "user_confirmed"]},
    "accepted_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/accepted_blocker"}
    },
    "route_state": {"enum": ["draft", "challenged", "selected", "frozen"]},
    "alternatives": {"type": "array", "items": {"type": "object"}},
    "selected_route_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "days": {"type": "array", "items": {"type": "object"}},
    "budget_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "amount_type": {"enum": ["exact", "estimate", "range", "unknown"]},
          "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
          "basis": {"enum": ["per_person", "per_group"]}
        },
        "additionalProperties": true
      }
    },
    "challenge_findings": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true,
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "accepted_blocker": {
      "type": "object",
      "required": ["blocker_id", "accepted_by_user", "accepted_at", "rationale"],
      "properties": {
        "blocker_id": {"$ref": "#/$defs/id"},
        "accepted_by_user": {"const": true},
        "accepted_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    }
  }
}
