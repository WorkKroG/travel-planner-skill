{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "itinerary.schema.json",
  "title": "Travel Planner itinerary v1",
  "type": "object",
  "required": [
    "schema_version",
    "trip_id",
    "document_status",
    "verification_level",
    "finalization_basis",
    "accepted_blockers",
    "route_state",
    "alternatives",
    "selected_route_id",
    "route_stops",
    "days",
    "budget_items",
    "budget_summary",
    "challenge_findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "trip_id": {"$ref": "#/$defs/id"},
    "document_status": {"enum": ["draft", "final"]},
    "verification_level": {"enum": ["none", "ai_reviewed", "codex_validated"]},
    "finalization_basis": {"enum": [null, "codex_validated", "user_confirmed"]},
    "accepted_blockers": {
      "type": "array",
      "items": {"$ref": "#/$defs/accepted_blocker"}
    },
    "route_state": {"enum": ["draft", "challenged", "selected", "frozen"]},
    "alternatives": {
      "type": "array",
      "items": {"$ref": "#/$defs/identified"}
    },
    "selected_route_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "route_stops": {
      "type": "array",
      "items": {"$ref": "#/$defs/identified"}
    },
    "days": {
      "type": "array",
      "items": {"$ref": "#/$defs/day"}
    },
    "budget_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/budget_item"}
    },
    "budget_summary": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/budget_summary"}]
    },
    "challenge_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/stored_blocker"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "id_list": {
      "type": "array",
      "items": {"$ref": "#/$defs/id"},
      "uniqueItems": true
    },
    "identified": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "readiness_ids": {"$ref": "#/$defs/id_list"},
        "source_ids": {"$ref": "#/$defs/id_list"},
        "claim_ids": {"$ref": "#/$defs/id_list"}
      },
      "additionalProperties": true
    },
    "day": {
      "type": "object",
      "required": ["id", "timeline"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "date": {"type": ["string", "null"], "format": "date"},
        "route_id": {"$ref": "#/$defs/id"},
        "overnight_stop_id": {"$ref": "#/$defs/id"},
        "readiness_ids": {"$ref": "#/$defs/id_list"},
        "source_ids": {"$ref": "#/$defs/id_list"},
        "claim_ids": {"$ref": "#/$defs/id_list"},
        "media": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/day_photo"}
        },
        "timeline": {
          "type": "array",
          "items": {"$ref": "#/$defs/timeline_event"}
        },
        "scenarios": {
          "type": "array",
          "items": {"$ref": "#/$defs/day_scenario"}
        }
      },
      "additionalProperties": true
    },
    "day_photo": {
      "type": "object",
      "required": ["path", "mime_type", "alt", "caption", "source_id", "license", "attribution", "width", "height"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mime_type": {"enum": ["image/jpeg", "image/png", "image/webp", "image/avif"]},
        "alt": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "caption": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "source_id": {"$ref": "#/$defs/id"},
        "license": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "attribution": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "timeline_event": {
      "type": "object",
      "required": ["id", "kind", "title", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["transport", "activity", "meal", "lodging", "rest", "checkpoint"]},
        "time": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "start_at": {"type": ["string", "null"], "format": "date-time"},
        "end_at": {"type": ["string", "null"], "format": "date-time"},
        "operating_start_at": {"type": ["string", "null"], "format": "date-time"},
        "operating_end_at": {"type": ["string", "null"], "format": "date-time"},
        "last_admission_at": {"type": ["string", "null"], "format": "date-time"},
        "last_service_at": {"type": ["string", "null"], "format": "date-time"},
        "allocated_minutes": {"type": "number", "minimum": 0},
        "components_minutes": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "required_buffer_markers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "buffer_markers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "connection": {
          "type": "object",
          "required": ["available_minutes", "minimum_minutes"],
          "properties": {
            "available_minutes": {"type": "number", "minimum": 0},
            "minimum_minutes": {"type": "number", "minimum": 0}
          },
          "additionalProperties": false
        },
        "route_id": {"$ref": "#/$defs/id"},
        "readiness_ids": {"$ref": "#/$defs/id_list"},
        "source_ids": {"$ref": "#/$defs/id_list"},
        "claim_ids": {"$ref": "#/$defs/id_list"},
        "links": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextual_link"}
        },
        "alternatives": {
          "type": "array",
          "items": {"$ref": "#/$defs/event_alternative"}
        },
        "checkpoint": {"$ref": "#/$defs/checkpoint"}
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {"kind": {"const": "checkpoint"}}
          },
          "then": {"required": ["checkpoint"]},
          "else": {"not": {"required": ["checkpoint"]}}
        }
      ],
      "additionalProperties": true
    },
    "day_scenario": {
      "type": "object",
      "required": ["id", "label", "timeline"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "summary": {"type": "string"},
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/timeline_event"}
        }
      },
      "additionalProperties": false
    },
    "contextual_link": {
      "type": "object",
      "required": ["label", "url", "kind", "requires_internet"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "kind": {"enum": ["map", "route", "official", "tickets", "source"]},
        "requires_internet": {"const": true}
      },
      "additionalProperties": false
    },
    "event_alternative": {
      "type": "object",
      "required": ["id", "title", "reason", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "price": {"type": "string"},
        "effort": {"type": "string"},
        "distance": {"type": "string"},
        "booking": {"type": "string"},
        "links": {
          "type": "array",
          "items": {"$ref": "#/$defs/contextual_link"}
        }
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "required": ["check", "adjust_plan"],
      "properties": {
        "check": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "adjust_plan": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    },
    "budget_item": {
      "type": "object",
      "required": ["id", "amount_type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "amount_type": {"enum": ["exact", "estimate", "range", "unknown"]},
        "amount": {"type": ["number", "null"], "minimum": 0},
        "amount_min": {"type": ["number", "null"], "minimum": 0},
        "amount_max": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "basis": {"enum": [null, "per_person", "per_group"]},
        "source_ids": {"$ref": "#/$defs/id_list"},
        "claim_ids": {"$ref": "#/$defs/id_list"}
      },
      "additionalProperties": true
    },
    "budget_summary": {
      "type": "object",
      "required": ["currency", "basis"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "basis": {"const": "per_group"},
        "amount": {"type": "number", "minimum": 0},
        "amount_min": {"type": "number", "minimum": 0},
        "amount_max": {"type": "number", "minimum": 0},
        "fx": {"$ref": "#/$defs/fx"}
      },
      "oneOf": [
        {
          "required": ["amount"],
          "not": {"anyOf": [{"required": ["amount_min"]}, {"required": ["amount_max"]}]}
        },
        {
          "required": ["amount_min", "amount_max"],
          "not": {"required": ["amount"]}
        }
      ],
      "additionalProperties": false
    },
    "fx": {
      "type": "object",
      "required": ["base_currency", "observed_at", "source_id", "rates"],
      "properties": {
        "base_currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "source_id": {"$ref": "#/$defs/id"},
        "rates": {
          "type": "object",
          "additionalProperties": {"type": "number", "exclusiveMinimum": 0}
        }
      },
      "additionalProperties": false
    },
    "stored_blocker": {
      "type": "object",
      "required": ["id", "code", "severity", "status", "path", "affected_ids", "message"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "code": {"type": "string", "minLength": 1},
        "severity": {"const": "blocking"},
        "status": {"enum": ["open", "unresolved"]},
        "path": {"type": "string", "minLength": 1},
        "affected_ids": {"$ref": "#/$defs/id_list"},
        "message": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "accepted_blocker": {
      "type": "object",
      "required": ["blocker_id", "accepted_by_user", "accepted_at", "rationale"],
      "properties": {
        "blocker_id": {"$ref": "#/$defs/id"},
        "accepted_by_user": {"const": true},
        "accepted_at": {"type": "string", "format": "date-time"},
        "rationale": {"type": "string", "minLength": 1, "pattern": "\\S"}
      },
      "additionalProperties": false
    }
  }
}
