<!doctype html>
<html lang="{{ view.language }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="light">
  <title>{{ view.title }} · {{ view.status_label }} · {{ tr('itinerary') }}</title>
  <style>{{ css }}</style>
</head>
<body class="{% if options.print_images %}print-images{% else %}no-print-images{% endif %}" data-days-shown-copy="{{ js_copy.daysShown }}" data-scenario-shown-copy="{{ js_copy.scenarioShown }}">
  <!--
  THESIS: A bright, readable travel guide with destination openings and a continuous chronological line.
  OWN-WORLD: Lemon headers, warm paper, cobalt actions, strong sans-serif titles, small outline icons, yellow checkpoints and blue closing fields.
  STORY: Readers understand the trip, scan unresolved choices, then follow one chronological timeline per day and open context only where it belongs.
  FIRST VIEWPORT: Trip identity and text route lead inside a bounded reading sheet; readiness, expenses, and saved blockers follow as calm document facts.
  FORM: Full reading document in the user-approved Lemon and Cobalt composition, 2026-09-07.
  FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
  -->
  {{ icons }}

  {% set event_icons = {
    'transport': 'route',
    'activity': 'activity',
    'meal': 'meal',
    'lodging': 'lodging',
    'rest': 'rest',
    'checkpoint': 'stop'
  } %}

  {% macro render_event_alternative_list(alternatives) -%}
  <div class="alternative-list">
    {% for alternative in alternatives %}
    <article class="event-alternative">
      <h6>{{ alternative.title }}</h6>
      <p><strong>{{ tr('reason') }}:</strong> {{ alternative.reason }}</p>
      {% if alternative.detail %}<p>{{ alternative.detail }}</p>{% endif %}
      {% if alternative.price or alternative.effort or alternative.distance or alternative.booking %}
      <dl class="alternative-meta">
        {% if alternative.price %}<div><dt>{{ tr('price') }}</dt><dd>{{ alternative.price }}</dd></div>{% endif %}
        {% if alternative.effort %}<div><dt>{{ tr('effort') }}</dt><dd>{{ alternative.effort }}</dd></div>{% endif %}
        {% if alternative.distance %}<div><dt>{{ tr('distance') }}</dt><dd>{{ alternative.distance }}</dd></div>{% endif %}
        {% if alternative.booking %}<div><dt>{{ tr('booking') }}</dt><dd>{{ alternative.booking }}</dd></div>{% endif %}
      </dl>
      {% endif %}
      {% if alternative.links %}
      <ul class="event-actions">
        {% for link in alternative.links %}
        <li>
          <a class="external-link" href="{{ link.url }}"><svg class="icon" aria-hidden="true"><use href="#icon-{% if link.kind in ['map', 'route'] %}route{% else %}arrow{% endif %}"></use></svg>{{ link.label }}</a>
          {% if link.requires_internet %}<span class="network-label">{{ tr('internet') }}</span>{% endif %}
        </li>
        {% endfor %}
      </ul>
      {% endif %}
    </article>
    {% endfor %}
  </div>
  {%- endmacro %}

  {% macro render_timeline(timeline, panel_id, day) -%}
  {% for period, events in timeline_groups(timeline) %}
  <div class="timeline-group">
  {% if period %}<h4 class="timeline-period">{{ tr(period) }}</h4>{% endif %}
  <ol class="timeline">
    {% for event in events %}
    <li class="timeline-event timeline-event--{{ event.kind }}" data-event-id="{{ event.event_id }}">
      <div class="timeline-time"><span class="timeline-time-label">{{ tr('time') }}</span><span>{{ event.time }}</span></div>
      <span class="timeline-marker" aria-hidden="true"><svg class="icon"><use href="#icon-{{ event.icon or event_icons[event.kind] }}"></use></svg></span>
      <div class="event-body">
        <p class="event-print-context">{{ tr('day') }} {{ day.number }} · {{ day.date_label }} · {{ day.region }}</p>
        <p class="event-kind">{{ enum_label(event.kind) }}</p>
        <h5>{{ event.title }}</h5>
        {% if event.detail %}<p>{{ event.detail }}</p>{% endif %}

        {% if event.checkpoint %}
        <dl class="checkpoint-contract">
          <div><dt>{{ tr('what_check') }}</dt><dd>{{ event.checkpoint.check }}</dd></div>
          <div><dt>{{ tr('how_adjust') }}</dt><dd>{{ event.checkpoint.adjust_plan }}</dd></div>
        </dl>
        {% endif %}

        {% if event.links %}
        <ul class="event-actions" aria-label="{{ event.title }}">
          {% for link in event.links %}
          <li>
            <a class="external-link" href="{{ link.url }}"><svg class="icon" aria-hidden="true"><use href="#icon-{% if link.kind in ['map', 'route'] %}route{% else %}arrow{% endif %}"></use></svg>{{ link.label }}</a>
            {% if link.requires_internet %}<span class="network-label"><svg class="icon" aria-hidden="true"><use href="#icon-cloud"></use></svg>{{ tr('internet') }}</span>{% endif %}
          </li>
          {% endfor %}
        </ul>
        {% endif %}

        {% if event.alternatives %}
        <details class="event-alternatives" id="{{ panel_id }}-{{ event.event_id }}-alternatives" open>
          <summary>{{ tr('alternatives', count=event.alternatives|length) }}</summary>
          {{ render_event_alternative_list(event.alternatives) }}
        </details>
        <div class="event-alternatives-print" aria-label="{{ tr('alternatives', count=event.alternatives|length) }}">
          <p><strong>{{ tr('alternatives', count=event.alternatives|length) }}</strong></p>
          {{ render_event_alternative_list(event.alternatives) }}
        </div>
        {% endif %}
      </div>
    </li>
    {% else %}<li class="empty-state">{{ tr('no_days') }}</li>{% endfor %}
  </ol>
  </div>
  {% endfor %}
  {%- endmacro %}

  <a class="skip-link" href="#main-content">{{ tr('skip') }}</a>

  <header class="trip-hero" id="trip-summary">
    <div class="hero-copy">
      <div class="status-line">
        <span class="document-status document-status--{% if not view.lifecycle_safe %}unsafe{% else %}{{ view.document_status }}{% endif %}">{{ view.status_label }}</span>
        <span>{{ view.summary.date_range }}</span>
        <span>{{ view.summary.traveler_count }} {{ tr('travellers') }}</span>
      </div>
      <p class="verification-line"><strong>{{ tr('verification') }}:</strong> {{ view.verification_label }}</p>
      {% if view.lifecycle_warning %}
      <div class="lifecycle-warning" role="alert">
        <strong>{{ tr('inconsistent') }}</strong>
        <p>{{ view.lifecycle_warning }}</p>
        {% if view.declared_final_label %}<p>{{ tr('declared_basis') }}: {{ view.declared_final_label }}</p>{% endif %}
      </div>
      {% endif %}
      <h1>{{ view.title }}</h1>
      <p class="trip-thesis">{{ view.summary.thesis }}</p>
      <p class="route-ribbon"><svg class="icon" aria-hidden="true"><use href="#icon-route"></use></svg>{{ view.summary.route_text }}</p>
      <p class="feasibility-note">{{ tr('feasibility_note') }}</p>
      <div class="summary-links">
        <a href="#route-overview">{{ tr('review_days') }}</a>
        <a href="#open-decisions">{{ view.open_decisions|length }} {{ tr('open_decisions_count') }}</a>
      </div>
    </div>
    <aside class="hero-facts" aria-label="{{ tr('readiness') }}">
      <section class="hero-fact">
        <h2>{{ tr('readiness') }}</h2>
        <p class="hero-fact-value">{{ tr('confirmed_of', confirmed=view.summary.readiness_confirmed, total=view.summary.readiness_total) }}</p>
        <a href="#preparation">{{ tr('review_preparation') }}</a>
      </section>
      <section class="hero-fact">
        <h2>{{ tr('recorded_expenses') }}</h2>
        {% for subtotal in view.budget.subtotals %}
        <p class="hero-fact-value">{{ money(subtotal.minimum, subtotal.currency) }}{% if subtotal.maximum != subtotal.minimum %} — {{ money(subtotal.maximum, subtotal.currency) }}{% endif %}</p>
        <p>{{ enum_label(subtotal.basis) }} · {{ subtotal.item_count }} {{ tr('rows') }}</p>
        {% else %}<p class="hero-fact-value">{{ tr('no_sum') }}</p>{% endfor %}
        <a href="#budget">{{ tr('excluded_review', count=view.budget.excluded_count) }}</a>
      </section>
      {% for finding in (view.unaccepted_blockers + view.accepted_blockers)[:2] %}
      <section class="warning-block">
        <p class="status-with-icon"><svg class="icon" aria-hidden="true"><use href="#icon-stop"></use></svg><strong>{{ tr('blocking') }} · {{ finding.code }}</strong></p>
        <p>{{ finding.message }}</p>
        {% if finding.acceptance_label %}<p class="acceptance-label">{{ finding.acceptance_label }}</p>{% endif %}
      </section>
      {% endfor %}
    </aside>
  </header>

  <div class="document-shell">
    <nav aria-label="{{ tr('contents') }}">
      <details class="contents">
        <summary><svg class="icon" aria-hidden="true"><use href="#icon-menu"></use></svg>{{ tr('contents') }}</summary>
        <ol>
          <li><a href="#trip-summary">{{ tr('trip_summary') }}</a></li>
          <li><a href="#blockers">{{ tr('blockers') }}</a></li>
          <li><a href="#route-overview">{{ tr('route_days') }}</a></li>
          <li><a href="#open-decisions">{{ tr('open_decisions') }}</a></li>
          <li><a href="#detailed-days">{{ tr('detailed_days') }}</a></li>
          {% for day in view.days %}<li class="day-link"><a href="#{{ day.day_id }}">{{ tr('day') }} {{ day.number }} · {{ day.region }}</a></li>{% endfor %}
          <li><a href="#preparation">{{ tr('preparation') }}</a></li>
          <li><a href="#budget">{{ tr('budget') }}</a></li>
          <li><a href="#risks">{{ tr('risks') }}</a></li>
        </ol>
      </details>
    </nav>

    <main id="main-content">
      <p class="enhancement-error" data-enhancement-error hidden>{{ tr('enhancement_error') }}</p>
      <p class="screen-reader-live" aria-live="polite" aria-atomic="true" data-live-region></p>

      <section class="document-section blocker-section" id="blockers" aria-labelledby="blockers-title">
        <h2 id="blockers-title">{{ tr('blockers') }}</h2>
        <p>{{ tr('blocker_intro') if view.unaccepted_blockers or view.accepted_blockers else tr('blocker_empty') }}</p>
        <section aria-labelledby="unaccepted-blockers-title">
          <h3 id="unaccepted-blockers-title">{{ tr('unaccepted_blockers') }}</h3>
          <ul class="blocker-list">
            {% for blocker in view.unaccepted_blockers %}
            <li class="blocker-item blocker-item--unaccepted">
              <p class="status-with-icon"><svg class="icon" aria-hidden="true"><use href="#icon-stop"></use></svg><strong>{{ blocker.code }} · {{ tr('blocking') }} · {{ tr('unresolved') }}</strong></p>
              <p>{{ blocker.message }}</p>
              <p>{{ tr('affects') }}: {{ blocker.affected_ids|join(', ') or enum_label('unknown') }} · {{ tr('path') }}: {{ blocker.path }}</p>
            </li>
            {% else %}<li>{{ tr('none_unaccepted') }}</li>{% endfor %}
          </ul>
        </section>
        <section aria-labelledby="accepted-blockers-title">
          <h3 id="accepted-blockers-title">{{ tr('accepted_blockers') }}</h3>
          <ul class="blocker-list">
            {% for blocker in view.accepted_blockers %}
            <li class="blocker-item blocker-item--accepted">
              <p class="status-with-icon"><svg class="icon" aria-hidden="true"><use href="#icon-stop"></use></svg><strong>{{ blocker.code }} · {{ tr('blocking') }} · {{ tr('unresolved') }}</strong></p>
              <p>{{ blocker.message }}</p>
              <p class="acceptance-label">{{ blocker.acceptance_label }}</p>
              <p>{{ tr('accepted_at') }}: {{ blocker.accepted_at }} · {{ tr('rationale') }}: {{ blocker.rationale }}</p>
              <p>{{ tr('affects') }}: {{ blocker.affected_ids|join(', ') or enum_label('unknown') }} · {{ tr('path') }}: {{ blocker.path }}</p>
            </li>
            {% else %}<li>{{ tr('none_accepted') }}</li>{% endfor %}
          </ul>
        </section>
      </section>

      <section class="document-section" id="route-overview" aria-labelledby="route-title">
        <h2 id="route-title">{{ tr('route_overview') }}</h2>
        <ol class="route-sequence">
          {% for stop in view.route %}
          <li class="route-stop"><strong>{{ stop.name }}</strong><span>{{ stop.dates }}{% if stop.nights is not none %} · {{ stop.nights }} {{ tr('nights') }}{% endif %}</span>{% if stop.transfer_label %}<span>{{ stop.transfer_label }}</span>{% endif %}</li>
          {% else %}<li>{{ tr('route_empty') }}</li>{% endfor %}
        </ol>
        <div class="interactive-controls" aria-label="{{ tr('filter_days') }}">
          <div class="filters" aria-label="{{ tr('filter_days') }}">
            <button type="button" data-filter="all" aria-pressed="true">{{ tr('all_days') }}</button>
            <button type="button" data-filter="unresolved" aria-pressed="false">{{ tr('unresolved_filter') }}</button>
            <button type="button" data-filter="weather" aria-pressed="false">{{ tr('weather_filter') }}</button>
            <button type="button" data-filter="transfer" aria-pressed="false">{{ tr('transfer_filter') }}</button>
            <button type="button" data-filter="warning" aria-pressed="false">{{ tr('warning_filter') }}</button>
          </div>
          <div class="filter-feedback"><p data-filter-results>{{ tr('days_shown', count=view.days|length) }}</p><p data-filter-empty hidden>{{ tr('no_matches') }} <button type="button" data-reset-filters>{{ tr('reset') }}</button></p></div>
        </div>
        <ol class="day-overview">
          {% for day in view.days %}
          <li data-day-overview="{{ day.day_id }}"><a href="#{{ day.day_id }}"><strong>{{ tr('day') }} {{ day.number }}</strong><span>{{ day.date_label }} · {{ day.weekday }}</span><span>{{ day.region }} — {{ day.thesis }}</span><small>{{ day.travel }} · {{ enum_label(day.load) }} {{ tr('load') }} · {{ enum_label(day.booking_state) }}</small></a></li>
          {% else %}<li>{{ tr('no_days') }}</li>{% endfor %}
        </ol>
      </section>

      <section class="document-section" id="open-decisions" aria-labelledby="decisions-title">
        <h2 id="decisions-title">{{ tr('open_decisions') }}</h2>
        <ul class="decision-list">
          {% for decision in view.open_decisions %}
          <li class="decision-item"><p class="status status--{{ decision.severity }}">{{ enum_label(decision.severity) }}</p><p class="decision-question">{{ decision.question }}</p><p>{{ decision.why }}</p><div class="decision-details"><span><strong>{{ tr('affects') }}:</strong> {{ decision.affected_ids|join(', ') or enum_label('unknown') }}</span><span><strong>{{ tr('deadline') }}:</strong> {{ decision.deadline }}</span><span><strong>{{ tr('next_action') }}:</strong> {{ decision.next_action }}</span></div></li>
          {% else %}<li>{{ tr('no_decisions') }}</li>{% endfor %}
        </ul>
      </section>

      <section class="days-section" id="detailed-days" aria-labelledby="days-title">
        <h2 id="days-title">{{ tr('detailed_days') }}</h2>
        {% for day in view.days %}
        <article class="day-chapter" id="{{ day.day_id }}" data-day data-weather="{{ day.weather_sensitive|string|lower }}" data-transfer="{{ (day.timeline|selectattr('kind', 'equalto', 'transport')|list|length > 0)|string|lower }}" data-unresolved="{{ (day.booking_state not in ['booked', 'confirmed'])|string|lower }}" data-warning="{{ (day.timeline|selectattr('kind', 'equalto', 'checkpoint')|list|length > 0)|string|lower }}" aria-labelledby="{{ day.day_id }}-title">
          <header class="day-heading">
            <div class="day-title-row">
              <div class="day-title-group"><h3 id="{{ day.day_id }}-title">{{ day.region }}</h3><p class="day-date">{{ day.date_label }} · {{ day.weekday }}</p></div>
              <div class="day-number"><span>{{ tr('day') }}</span><strong>{{ '%02d' | format(day.number) }}</strong></div>
            </div>
            <p class="day-thesis">{{ day.thesis }}</p>
            {% if media.get(day.day_id) %}
            <div class="day-gallery day-gallery--{{ media[day.day_id]|length }}" role="group" aria-label="{{ tr('day_gallery', number=day.number) }}">
              {% for photo in media[day.day_id] %}
              <figure class="day-photo" data-optional-media>
                <img src="{{ photo.data_url }}" alt="{{ photo.alt }}" width="{{ photo.width }}" height="{{ photo.height }}" loading="lazy" decoding="async" data-media-image>
                <p class="media-fallback" data-media-fallback hidden>{{ tr('media_unavailable') }}</p>
                <figcaption>{{ photo.caption }}<small class="photo-credit"><a class="external-link" href="{{ photo.source_url }}">{{ photo.attribution }}</a> · {{ photo.license }}</small></figcaption>
              </figure>
              {% endfor %}
            </div>
            {% endif %}
            <dl class="day-meta"><div><dt>{{ tr('overnight') }}</dt><dd>{{ day.overnight }}</dd></div><div><dt>{{ tr('travel') }}</dt><dd>{{ day.travel }}</dd></div><div><dt>{{ tr('load')|capitalize }}</dt><dd>{{ enum_label(day.load) }}</dd></div></dl>
          </header>
          <div class="day-body">
          <h4 class="day-plan-title">{{ tr('day_plan') }}</h4>
          {% if day.scenarios %}<p class="day-plan-intro">{{ tr('choose_scenario') }}</p>{% endif %}
          {% if day.weather_sensitive %}<p class="weather-note"><svg class="icon" aria-hidden="true"><use href="#icon-cloud"></use></svg>{{ tr('weather_sensitive') }}</p>{% endif %}

          {% if day.scenarios %}
          <div class="scenario-tabs interactive-controls" data-scenario-tabs hidden role="tablist" aria-label="{{ tr('scenario_view', number=day.number) }}">
            <button type="button" id="{{ day.day_id }}-tab-primary" role="tab" aria-selected="true" aria-controls="{{ day.day_id }}-panel-primary" tabindex="0" data-show-scenario="primary"><svg class="icon" aria-hidden="true"><use href="#icon-{{ day.primary_icon or 'route' }}"></use></svg>{{ day.primary_label or tr('primary') }}</button>
            {% for scenario in day.scenarios %}<button type="button" id="{{ day.day_id }}-tab-alternative-{{ scenario.scenario_id }}" role="tab" aria-selected="false" aria-controls="{{ day.day_id }}-panel-alternative-{{ scenario.scenario_id }}" tabindex="-1" data-show-scenario="alternative-{{ scenario.scenario_id }}"><svg class="icon" aria-hidden="true"><use href="#icon-{{ scenario.icon or ('cloud' if day.weather_sensitive else 'conflict') }}"></use></svg>{{ scenario.label }}</button>{% endfor %}
          </div>
          {% endif %}

          <div class="scenario-stack">
            <section class="scenario-panel scenario-panel--primary"{% if day.scenarios %} id="{{ day.day_id }}-panel-primary" data-scenario="primary" role="tabpanel" aria-labelledby="{{ day.day_id }}-tab-primary" tabindex="0"{% endif %}>
              {% if day.scenarios %}<h4 class="scenario-heading">{{ day.primary_label or tr('primary_scenario') }}</h4>{% else %}<h4 class="scenario-heading scenario-heading--primary-only">{{ tr('timeline') }}</h4>{% endif %}
              {% if day.primary_summary %}<p class="scenario-summary">{{ day.primary_summary }}</p>{% endif %}
              {{ render_timeline(day.timeline, day.day_id ~ '-primary', day) }}
            </section>
            {% for scenario in day.scenarios %}
            <section class="scenario-panel scenario-panel--alternative" id="{{ day.day_id }}-panel-alternative-{{ scenario.scenario_id }}" data-scenario="alternative-{{ scenario.scenario_id }}" role="tabpanel" aria-labelledby="{{ day.day_id }}-tab-alternative-{{ scenario.scenario_id }}" tabindex="0">
              <h4 class="scenario-heading">{{ tr('alternative_scenario') }} · {{ scenario.label }}</h4>
              {% if scenario.summary %}<p class="scenario-summary">{{ scenario.summary }}</p>{% endif %}
              {{ render_timeline(scenario.timeline, day.day_id ~ '-alternative-' ~ scenario.scenario_id, day) }}
            </section>
            {% endfor %}
          </div>

          </div>

          <nav class="day-nav" aria-label="{{ tr('detailed_days') }}">
            {% if not loop.first %}<a href="#{{ view.days[loop.index0 - 1].day_id }}">← {{ tr('previous_day') }}</a>{% else %}<span></span>{% endif %}
            {% if not loop.last %}<a href="#{{ view.days[loop.index0 + 1].day_id }}">{{ tr('next_day') }} →</a>{% endif %}
          </nav>
        </article>
        {% endfor %}
      </section>

      <section class="document-section" id="preparation" aria-labelledby="preparation-title">
        <h2 id="preparation-title">{{ tr('bookings_readiness') }}</h2>
        <p>{{ tr('readiness_note', confirmed=view.summary.readiness_confirmed, total=view.summary.readiness_total) }}</p>
        <ul class="readiness-list">
          {% for item in view.readiness %}<li class="readiness-item"><p class="status-with-icon"><svg class="icon" aria-hidden="true"><use href="#icon-{% if item.status == 'confirmed' %}check{% elif item.status == 'recheck' %}recheck{% else %}square{% endif %}"></use></svg><strong>{{ item.title }}</strong></p><p><span class="status status--{{ item.status|replace('_', '-') }}">{{ enum_label(item.status) }}</span> {{ enum_label(item.category) }} · {{ tr('owner') }}: {{ item.owner_id }}{% if item.due_at %} · {{ tr('due') }}: {{ item.due_at }}{% endif %}{% if item.next_check_at %} · {{ tr('next_check') }}: {{ item.next_check_at }}{% endif %}</p>{% if item.issue %}<p>{{ item.issue }}</p>{% endif %}{% if item.next_action %}<p>{{ tr('next_action') }}: {{ item.next_action }}</p>{% endif %}</li>{% else %}<li>{{ tr('no_readiness') }}</li>{% endfor %}
        </ul>
      </section>

      <section class="document-section" id="budget" aria-labelledby="budget-title">
        <h2 id="budget-title">{{ tr('recorded_expenses') }}</h2><p>{{ tr('expenses_note') }}</p>
        <div class="budget-summary">{% for subtotal in view.budget.subtotals %}<div><span>{{ subtotal.currency }} · {{ enum_label(subtotal.basis) }}</span><strong>{{ money(subtotal.minimum, subtotal.currency) }}{% if subtotal.maximum != subtotal.minimum %} — {{ money(subtotal.maximum, subtotal.currency) }}{% endif %}</strong><span>{{ subtotal.item_count }} {{ tr('rows') }}</span></div>{% else %}<p>{{ tr('no_sum') }}</p>{% endfor %}</div>
        <p>{{ tr('excluded_rows', count=view.budget.excluded_count) }}</p>
        <table class="budget-table"><thead><tr><th>{{ tr('category') }}</th><th>{{ tr('recorded_amount') }}</th><th>{{ tr('type') }}</th><th>{{ tr('basis') }}</th><th>{{ tr('subtotal') }}</th></tr></thead><tbody>{% for category in view.budget.categories %}<tr><td data-label="{{ tr('category') }}">{{ category.category }}</td><td data-label="{{ tr('recorded_amount') }}">{{ money(category.minimum, category.currency) }}{% if category.maximum != category.minimum %} — {{ money(category.maximum, category.currency) }}{% endif %}</td><td data-label="{{ tr('type') }}">{{ enum_label(category.amount_type) }}</td><td data-label="{{ tr('basis') }}">{{ enum_label(category.basis) }}</td><td data-label="{{ tr('subtotal') }}">{{ category.exclusion_reason or tr('included') }}</td></tr>{% else %}<tr><td colspan="5">{{ tr('no_budget') }}</td></tr>{% endfor %}</tbody></table>
      </section>

      <section class="document-section" id="risks" aria-labelledby="risks-title"><h2 id="risks-title">{{ tr('risks') }}</h2><ul class="risk-list">{% for finding in view.risks %}<li class="risk-item risk-item--{{ finding.severity }}"><p class="status-with-icon"><svg class="icon" aria-hidden="true"><use href="#icon-{% if finding.severity == 'blocking' %}stop{% else %}recheck{% endif %}"></use></svg><strong>{{ finding.code }} · {{ enum_label(finding.severity) }}</strong></p><p>{{ finding.message }}</p><p>{{ tr('affects') }}: {{ finding.affected_ids|join(', ') or enum_label('unknown') }} · {{ tr('path') }}: {{ finding.path }}</p></li>{% else %}<li>{{ tr('no_risks') }}</li>{% endfor %}</ul></section>

    </main>
  </div>

  <footer class="document-footer" id="document-version" data-document-status="{{ view.document_status }}" data-verification-level="{{ view.verification_level }}" data-finalization-basis="{{ view.finalization_basis or 'none' }}"><strong>{{ view.title }}</strong> · {{ view.trip_id }} · {{ view.status_label }} · {{ view.verification_label }} · {{ tr('generated') }} {{ view.generated_at.isoformat() }} · {{ tr('artefact') }}</footer>
  <script>{{ js }}</script>
</body>
</html>
